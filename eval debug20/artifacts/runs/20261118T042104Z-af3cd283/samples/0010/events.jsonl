{"sequence": 7, "time_s": 2.536867, "type": "search_finished", "query": "[scheduled evidence]", "subject": "", "status": "ok", "returned_pages": [], "mode": "trace", "unit_id": "__scheduled_evidence__"}
{"sequence": 8, "time_s": 2.536904, "type": "evidence", "evidence": {"evidence_id": "d1s0", "title": "Margaret Fiennes, 11th Baroness Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d1s0", "text": "Margaret Fiennes, 11th Baroness Dacre (1541 – 16 March 1612) was a \"suo jure\" peeress having been created Baroness Dacre by King James I of England in 1604.", "visible_time_s": 2.536894900000334, "requested_subject": "", "resolved_title": "Margaret Fiennes, 11th Baroness Dacre", "entity_resolution": "unspecified"}}
{"sequence": 9, "time_s": 2.53696, "type": "evidence", "evidence": {"evidence_id": "d1s1", "title": "Margaret Fiennes, 11th Baroness Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d1s1", "text": "She was the daughter of Thomas Fiennes, 9th Baron Dacre who was executed for murder in the year of her birth.", "visible_time_s": 2.536952899998141, "requested_subject": "", "resolved_title": "Margaret Fiennes, 11th Baroness Dacre", "entity_resolution": "unspecified"}}
{"sequence": 10, "time_s": 2.537015, "type": "evidence", "evidence": {"evidence_id": "d1s2", "title": "Margaret Fiennes, 11th Baroness Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d1s2", "text": "His title and lands had been forfeited to the crown.", "visible_time_s": 2.5370101999978942, "requested_subject": "", "resolved_title": "Margaret Fiennes, 11th Baroness Dacre", "entity_resolution": "unspecified"}}
{"sequence": 11, "time_s": 2.537035, "type": "evidence", "evidence": {"evidence_id": "d1s3", "title": "Margaret Fiennes, 11th Baroness Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d1s3", "text": "Baroness Margaret's husband was Sampson Lennard MP.", "visible_time_s": 2.537032399999589, "requested_subject": "", "resolved_title": "Margaret Fiennes, 11th Baroness Dacre", "entity_resolution": "unspecified"}}
{"sequence": 12, "time_s": 2.53705, "type": "evidence", "evidence": {"evidence_id": "d1s4", "title": "Margaret Fiennes, 11th Baroness Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d1s4", "text": "She was also known as Baroness Dacre of the South.", "visible_time_s": 2.537047799996799, "requested_subject": "", "resolved_title": "Margaret Fiennes, 11th Baroness Dacre", "entity_resolution": "unspecified"}}
{"sequence": 13, "time_s": 2.537064, "type": "evidence", "evidence": {"evidence_id": "d2s0", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s0", "text": "Gregory Fiennes, 10th Baron Dacre (25 June 1539, Hurstmonceaux, Sussex – 25 December 1594, Chelsea, Middlesex, England) was an English courtier.", "visible_time_s": 2.5370617999979004, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 14, "time_s": 2.537081, "type": "evidence", "evidence": {"evidence_id": "d2s1", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s1", "text": "He was the son of Thomas Fiennes, 9th Baron Dacre (c. 1515-1541) and Mary Neville.", "visible_time_s": 2.5370788000000175, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 15, "time_s": 2.537096, "type": "evidence", "evidence": {"evidence_id": "d2s2", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s2", "text": "His father was convicted of the murder of a gamekeeper and hanged like a common criminal at Tyburn in 1541, and the aftermath the family was stripped of its lands and titles by Henry VIII.", "visible_time_s": 2.5370933999984118, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 16, "time_s": 2.537111, "type": "evidence", "evidence": {"evidence_id": "d2s3", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s3", "text": "In the following years, his mother battled to have the properties restored on behalf of her children, and on her ascension in 1558 Queen Elizabeth restored the title of Baron Dacre to Gregory, his elder brother Thomas having died of the plague at age 15.", "visible_time_s": 2.537108699998498, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 17, "time_s": 2.537127, "type": "evidence", "evidence": {"evidence_id": "d2s4", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s4", "text": "In 1565, he married Anne Sackville, daughter of Sir Richard Sackville and Winifred Brydges.", "visible_time_s": 2.5371242000001075, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 18, "time_s": 2.537149, "type": "evidence", "evidence": {"evidence_id": "d2s5", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s5", "text": "They had one daughter, Elizabeth, who died young.", "visible_time_s": 2.5371468999983335, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 19, "time_s": 2.537164, "type": "evidence", "evidence": {"evidence_id": "d2s6", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s6", "text": "Fiennes, his wife, and their daughter, are buried at Chelsea Old Church within a magnificent marble tomb.", "visible_time_s": 2.5371611999980814, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 20, "time_s": 2.537178, "type": "evidence", "evidence": {"evidence_id": "d2s7", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s7", "text": "Fiennes also had an illegitimate daughter named Mary in about 1571, but no mention of this child is made in the tomb heraldry.", "visible_time_s": 2.537175199999183, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 21, "time_s": 2.537192, "type": "evidence", "evidence": {"evidence_id": "d2s8", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s8", "text": "Gregory Fiennes is a sitter with his mother in a significant portrait by Hans Eworth.", "visible_time_s": 2.537189299997408, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 22, "time_s": 2.537205, "type": "evidence", "evidence": {"evidence_id": "d2s9", "title": "Gregory Fiennes, 10th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d2s9", "text": "He was succeeded by his sister Margaret Fiennes, 11th Baroness Dacre.", "visible_time_s": 2.537202299998171, "requested_subject": "", "resolved_title": "Gregory Fiennes, 10th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 23, "time_s": 2.537218, "type": "evidence", "evidence": {"evidence_id": "d3s0", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s0", "text": "Thomas Fiennes, 9th Baron Dacre (ca. 1515 – 1541) was an English aristocrat notable for his conviction and execution for murder.", "visible_time_s": 2.537215999996988, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 24, "time_s": 2.537233, "type": "evidence", "evidence": {"evidence_id": "d3s1", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s1", "text": "Dacre was the son of Sir Thomas Fiennes and Jane Sutton daughter of Edward Sutton, 2nd Baron Dudley.", "visible_time_s": 2.537230699999782, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 25, "time_s": 2.537246, "type": "evidence", "evidence": {"evidence_id": "d3s2", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s2", "text": "When his father died in 1528 he became heir apparent to his grandfather's title and the family seat at Herstmonceux Castle in Sussex, and he succeeded to the title at the age of approximately 19 in 1533.", "visible_time_s": 2.537243999999191, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 26, "time_s": 2.537261, "type": "evidence", "evidence": {"evidence_id": "d3s3", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s3", "text": "In 1536 he married Mary Neville, daughter of George Neville, 5th Baron Bergavenny.", "visible_time_s": 2.5372588999998698, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 27, "time_s": 2.537275, "type": "evidence", "evidence": {"evidence_id": "d3s4", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s4", "text": "They had three children.", "visible_time_s": 2.537272599998687, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 28, "time_s": 2.537289, "type": "evidence", "evidence": {"evidence_id": "d3s5", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s5", "text": "His only sister Anne married John Mantell, who was hanged along with his brother-in-law.", "visible_time_s": 2.5372862000003806, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 29, "time_s": 2.537302, "type": "evidence", "evidence": {"evidence_id": "d3s6", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s6", "text": "He was a member of the jury at the trial of Anne Boleyn in 1536, and of Thomas, Lord Darcy, and John, Lord Hussey in May 1537 (for their part in the Pilgrimage of Grace), and of Baron Montagu and the Marquess of Exeter in 1538 for the Exeter Conspiracy.", "visible_time_s": 2.5372995999969135, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 30, "time_s": 2.537316, "type": "evidence", "evidence": {"evidence_id": "d3s7", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s7", "text": "On 30 April 1541 Dacre led a party of gentlemen including his brother-in-law John Mantell, John Frowds, George Roidon, Thomas Isleie, and two yeomen Richard Middleton and John Goldwell, to poach on the lands of Sir Nicholas Pelham of Laughton.", "visible_time_s": 2.537313799999538, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 31, "time_s": 2.53733, "type": "evidence", "evidence": {"evidence_id": "d3s8", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s8", "text": "During the escapade they encountered John Busbrig (or Busbridge), James Busbrig, and Richard Summer who were servants of Pelham.", "visible_time_s": 2.5373275999991165, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 32, "time_s": 2.537344, "type": "evidence", "evidence": {"evidence_id": "d3s9", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s9", "text": "The encounter turned into an affray during which John Busbrig was fatally wounded.", "visible_time_s": 2.5373416999973415, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 33, "time_s": 2.537365, "type": "evidence", "evidence": {"evidence_id": "d3s10", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s10", "text": "Dacre and several others were charged with murder and arraigned before the Lord High Steward, Lord Audley of Walden on 27 June.", "visible_time_s": 2.5373627999979362, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 34, "time_s": 2.537379, "type": "evidence", "evidence": {"evidence_id": "d3s11", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s11", "text": "Dacre originally entered a plea of not guilty but was later persuaded to change it to guilty and throw himself upon the King's mercy in the hope of a reprieve.", "visible_time_s": 2.537376599997515, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 35, "time_s": 2.537393, "type": "evidence", "evidence": {"evidence_id": "d3s12", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s12", "text": "Unlike many of his contemporaries he was not executed by beheading but was hanged at Tyburn on 29 June 1541.", "visible_time_s": 2.5373903999970935, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 36, "time_s": 2.537406, "type": "evidence", "evidence": {"evidence_id": "d3s13", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s13", "text": "An account of the execution in Hall's Chronicle says:\nMantell, Frowds and Roidon were also executed for the crime.", "visible_time_s": 2.5374040999995486, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 37, "time_s": 2.53742, "type": "evidence", "evidence": {"evidence_id": "d3s14", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s14", "text": "Dacre's family were stripped of their lands and title, but the title was restored to his second son Gregory in 1558", "visible_time_s": 2.5374179999998887, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 38, "time_s": 2.537434, "type": "evidence", "evidence": {"evidence_id": "d3s15", "title": "Thomas Fiennes, 9th Baron Dacre", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d3s15", "text": "(the elder son Thomas died before the restitution, aged 15).", "visible_time_s": 2.537431499997183, "requested_subject": "", "resolved_title": "Thomas Fiennes, 9th Baron Dacre", "entity_resolution": "unspecified"}}
{"sequence": 39, "time_s": 2.537447, "type": "evidence", "evidence": {"evidence_id": "d4s0", "title": "Sampson Lennard", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d4s0", "text": "Sampson Lennard( died 20 September 1615), of Chevening in Kent, was an English Member of Parliament who represented an unusually large number of different constituencies during the reigns of Elizabeth I and James I.", "visible_time_s": 2.537445199999638, "requested_subject": "", "resolved_title": "Sampson Lennard", "entity_resolution": "unspecified"}}
{"sequence": 40, "time_s": 2.537462, "type": "evidence", "evidence": {"evidence_id": "d4s1", "title": "Sampson Lennard", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d4s1", "text": "A prominent member of the Kent and Sussex gentry, Lennard was High Sheriff of Kent in 1590 – 1.", "visible_time_s": 2.537459699997271, "requested_subject": "", "resolved_title": "Sampson Lennard", "entity_resolution": "unspecified"}}
{"sequence": 41, "time_s": 2.537479, "type": "evidence", "evidence": {"evidence_id": "d4s2", "title": "Sampson Lennard", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d4s2", "text": "He entered Parliament in 1571 as member for Launceston( Cornwall).", "visible_time_s": 2.5374765999986266, "requested_subject": "", "resolved_title": "Sampson Lennard", "entity_resolution": "unspecified"}}
{"sequence": 42, "time_s": 2.537493, "type": "evidence", "evidence": {"evidence_id": "d4s3", "title": "Sampson Lennard", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d4s3", "text": "He subsequently also represented Bramber( 1584 – 5), St Mawes( 1586 – 7), Christchurch( 1589), St Germans( 1593), Rye( 1597), Liskeard( 1601) and Sussex( 1614).", "visible_time_s": 2.537490799997613, "requested_subject": "", "resolved_title": "Sampson Lennard", "entity_resolution": "unspecified"}}
{"sequence": 43, "time_s": 2.537508, "type": "evidence", "evidence": {"evidence_id": "d4s4", "title": "Sampson Lennard", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d4s4", "text": "Lennard married Margaret Fiennes( 1541 – 1612), daughter of Thomas Fiennes, 9th Baron Dacre, and after her brother's death in 1594 he successfully claimed the barony on her behalf, so that she became the 11th Baroness Dacre.", "visible_time_s": 2.537505799999053, "requested_subject": "", "resolved_title": "Sampson Lennard", "entity_resolution": "unspecified"}}
{"sequence": 44, "time_s": 2.537523, "type": "evidence", "evidence": {"evidence_id": "d4s5", "title": "Sampson Lennard", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d4s5", "text": "They had seven children, and their younger son, Sir Henry Lennard( 1570 – 1616), succeeded his mother as 12th Baron Dacre.", "visible_time_s": 2.537521199999901, "requested_subject": "", "resolved_title": "Sampson Lennard", "entity_resolution": "unspecified"}}
{"sequence": 45, "time_s": 2.537538, "type": "evidence", "evidence": {"evidence_id": "d5s0", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s0", "text": "Sir Robert More( 21 May", "visible_time_s": 2.5375362999984645, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 46, "time_s": 2.537553, "type": "evidence", "evidence": {"evidence_id": "d5s1", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s1", "text": "1581 – February 1626) was an English politician who sat in the House of Commons from 1601.", "visible_time_s": 2.5375504000003275, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 47, "time_s": 2.537568, "type": "evidence", "evidence": {"evidence_id": "d5s2", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s2", "text": "More was the eldest son of Sir George More of Loseley and his first wife Anne Poynings, daughter of Sir Adrian Poynings.", "visible_time_s": 2.5375659999990603, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 48, "time_s": 2.537582, "type": "evidence", "evidence": {"evidence_id": "d5s3", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s3", "text": "He entered Corpus Christi College, Oxford in 1595 and was awarded BA in 1598.", "visible_time_s": 2.5375800999972853, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 49, "time_s": 2.537597, "type": "evidence", "evidence": {"evidence_id": "d5s4", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s4", "text": "In 1600 he entered the Inner Temple, and also became with his father joint keeper of Farnham Little Park.", "visible_time_s": 2.5375944999977946, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 50, "time_s": 2.537612, "type": "evidence", "evidence": {"evidence_id": "d5s5", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s5", "text": "In 1601, More was elected Member of Parliament for Guildford.", "visible_time_s": 2.537609599999996, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 51, "time_s": 2.537626, "type": "evidence", "evidence": {"evidence_id": "d5s6", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s6", "text": "He was knighted between 17 October 1601 and 28 February 1604.", "visible_time_s": 2.5376232999988133, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 52, "time_s": 2.53764, "type": "evidence", "evidence": {"evidence_id": "d5s7", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s7", "text": "He was joint constable with his father of Farnham Castle from about 1603 to 1608 and probably became a gentleman pensioner early in the reign of King James.", "visible_time_s": 2.537637800000084, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 53, "time_s": 2.537655, "type": "evidence", "evidence": {"evidence_id": "d5s8", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s8", "text": "In 1604 he was elected MP for Surrey.", "visible_time_s": 2.5376523999984784, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 54, "time_s": 2.537669, "type": "evidence", "evidence": {"evidence_id": "d5s9", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s9", "text": "He was a J.P. for Surrey during the reign of James I.", "visible_time_s": 2.537666599997465, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 55, "time_s": 2.537684, "type": "evidence", "evidence": {"evidence_id": "d5s10", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s10", "text": "In 1614 he was elected MP for Guildford again.", "visible_time_s": 2.5376814999981434, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
