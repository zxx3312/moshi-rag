{"sequence": 57, "time_s": 2.537712, "type": "evidence", "evidence": {"evidence_id": "d5s12", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s12", "text": "In 1621 he was re-elected MP for Guildford.", "visible_time_s": 2.5377095000003465, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
