{"sequence": 59, "time_s": 2.537759, "type": "evidence", "evidence": {"evidence_id": "d5s14", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s14", "text": "More died on 2 or 10 February 1626 at the age of 44 and was outlived by his father.", "visible_time_s": 2.537756599998829, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
{"sequence": 60, "time_s": 2.537776, "type": "evidence", "evidence": {"evidence_id": "d5s15", "title": "Robert More", "url": "https://trace.invalid/2wikimultihopqa_37a7af5a0bb011ebab90acde48001122_immediate/d5s15", "text": "He was buried in the Loseley chapel at St Nicholas ’s, Guildford.", "visible_time_s": 2.537773299998662, "requested_subject": "", "resolved_title": "Robert More", "entity_resolution": "unspecified"}}
