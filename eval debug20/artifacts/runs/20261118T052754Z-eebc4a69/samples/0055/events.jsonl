{"sequence": 9, "time_s": 3.782639, "type": "evidence", "evidence": {"evidence_id": "d1s0", "title": "Gordonia (plant)", "url": "https://trace.invalid/hotpotqa_5ae3f4fe5542995ad6573ce8_immediate/d1s0", "text": "Gordonia is a genus of flowering plants in the family Theaceae, related to \"Franklinia\", \"Camellia\" and \"Stewartia\".", "visible_time_s": 3.782627799999318, "requested_subject": "", "resolved_title": "Gordonia (plant)", "entity_resolution": "unspecified"}}
{"sequence": 10, "time_s": 3.782721, "type": "evidence", "evidence": {"evidence_id": "d1s1", "title": "Gordonia (plant)", "url": "https://trace.invalid/hotpotqa_5ae3f4fe5542995ad6573ce8_immediate/d1s1", "text": "Of the roughly 40 species, all but two are native to southeast Asia in southern China, Taiwan and Indochina.", "visible_time_s": 3.7827150999946753, "requested_subject": "", "resolved_title": "Gordonia (plant)", "entity_resolution": "unspecified"}}
