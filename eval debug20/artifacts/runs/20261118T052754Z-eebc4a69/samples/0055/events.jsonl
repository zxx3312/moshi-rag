{"sequence": 27, "time_s": 3.783102, "type": "evidence", "evidence": {"evidence_id": "d7s3", "title": "Osbeckia octandra", "url": "https://trace.invalid/hotpotqa_5ae3f4fe5542995ad6573ce8_immediate/d7s3", "text": "Fruits are dry capsules with numerous seeds.", "visible_time_s": 3.7830979999998817, "requested_subject": "", "resolved_title": "Osbeckia octandra", "entity_resolution": "unspecified"}}
{"sequence": 28, "time_s": 3.783124, "type": "evidence", "evidence": {"evidence_id": "d7s4", "title": "Osbeckia octandra", "url": "https://trace.invalid/hotpotqa_5ae3f4fe5542995ad6573ce8_immediate/d7s4", "text": "Leaves and young stems are edible, whereas leaves, stem and bark also widely used as a valuable medicine in Ayurveda for treating Diabetes mellitus, Hepatitis, Jaundice, and Hyperlipidaemia.", "visible_time_s": 3.783120299995062, "requested_subject": "", "resolved_title": "Osbeckia octandra", "entity_resolution": "unspecified"}}
{"sequence": 29, "time_s": 3.783147, "type": "evidence", "evidence": {"evidence_id": "d7s5", "title": "Osbeckia octandra", "url": "https://trace.invalid/hotpotqa_5ae3f4fe5542995ad6573ce8_immediate/d7s5", "text": "The juice extracted from \"Osbeckia octandra\" leaves is an effective treatment for liver damage caused by Paracetamol poisoning", "visible_time_s": 3.783142799999041, "requested_subject": "", "resolved_title": "Osbeckia octandra", "entity_resolution": "unspecified"}}
