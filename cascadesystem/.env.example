# Copy to .env (ignored by Git), or set variables in your shell.
TINKER_API_KEY=
CASCADE_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
CASCADE_MODEL=openai/gpt-oss-120b
# Optional: tinker://.../sampler_weights/...; only judge/judge_repair use it.
CASCADE_JUDGE_MODEL=
CASCADE_JUDGE_REASONING_EFFORT=low
CASCADE_REASONING_EFFORT=low
CASCADE_MAX_TOKENS=4096
CASCADE_TIMEOUT_S=45
CASCADE_WIKI_LANGUAGE=en
CASCADE_PROGRESS_S=3
CASCADE_FEEDBACK_TIMEOUT_S=6
