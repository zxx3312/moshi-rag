{"sequence": 49, "time_s": 12.125, "type": "utterance", "action": "Final Answer", "text": "Eysteinn's mother is Yrsa. Yrsa's father is Halga.", "claims": [{"unit_id": "u1", "description": "Mother of Eysteinn", "value": "Yrsa", "citations": ["d1s0"], "quotes": [{"evidence_id": "d1s0", "text": "Eysteinn (Swedish: Östen; died ca 600) was the son of Eadgils and Yrsa of Saxony."}]}, {"unit_id": "u2", "description": "Father of Yrsa (maternal grandfather of Eysteinn)", "value": "Halga", "citations": ["d3s1"], "quotes": [{"evidence_id": "d3s1", "text": "She appears in several versions relating to her husband, the Swedish king Eadgils, and/or to her father and rapist/lover/husband Halga (the younger brother of king Hroðgar who received Beowulf) and their son Hroðulf."}]}], "unresolved": [], "fallback": false, "evidence_snapshot_ids": ["d1s0", "d1s1", "d1s2", "d1s3", "d1s4", "d1s5", "d1s6", "d1s7", "d1s8", "d1s9", "d1s10", "d1s11", "d1s12", "d2s0", "d5s0", "d5s1", "d7s0", "d7s1", "d9s0", "d3s0", "d3s1", "d3s2", "d3s3", "d3s4", "d3s5", "d3s6", "d4s0", "d4s1", "d4s2", "d4s3", "d6s0", "d8s0", "d8s1", "d10s0", "d10s1"], "language": "en"}
